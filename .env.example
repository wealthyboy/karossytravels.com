APP_NAME="Karossy Travels"
APP_ENV=local
TRAVEL_DEMO_PAYMENT_ENABLED=false
APP_KEY=
APP_DEBUG=true
APP_URL=http://karossytravels.test
USD_NGN_FALLBACK_RATE=1600
WEBSITE_URL=https://karossytravels.com

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
TRAVEL_LOCAL_CALLBACK_FINALIZATION=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@avenuemontaigne.ng"
MAIL_FROM_NAME="${APP_NAME}"
ZEPTO_API_KEY=
ZEPTO_API_URL="https://api.zeptomail.com/v1.1/email"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Keep `fake` for local UI development. Change to `travel_api` after the travel API enables
# the required REST/JSON products and provides certification credentials.
TRAVEL_PROVIDER=fake
TRAVEL_DEFAULT_CURRENCY=NGN
TRAVEL_SUPPORT_EMAIL=info@karossytravels.com
TRAVEL_SUPPORT_PHONE=
TRAVEL_OFFER_TTL_MINUTES=15
TRAVEL_CONSUMER_MARKUP_BPS=0
TRAVEL_BUSINESS_MARKUP_BPS=0
TRAVEL_EMPLOYEE_MARKUP_BPS=0
TRAVEL_CORPORATE_MARKUP_BPS=0
TRAVEL_AFFILIATE_MARKUP_BPS=0

TRAVEL_API_ENVIRONMENT=cert
TRAVEL_API_AUTH_SCHEME=epr_v2
TRAVEL_API_ACCESS_TOKEN=
TRAVEL_API_USER_ID=
TRAVEL_API_PASSWORD=
TRAVEL_API_CERT_URL=
TRAVEL_API_PRODUCTION_URL=
TRAVEL_API_CLIENT_ID=
TRAVEL_API_CLIENT_SECRET=
TRAVEL_API_APPLICATION_ID=
TRAVEL_API_EPR=
TRAVEL_API_PCC=
TRAVEL_API_ORGANIZATION=
TRAVEL_API_DOMAIN=AA
TRAVEL_API_TIMEOUT=30
TRAVEL_API_TOKEN_PATH=/v2/auth/token
TRAVEL_API_FLIGHT_SHOP_PATH=/v5/offers/shop
TRAVEL_API_FLIGHT_REVALIDATE_PATH=/v5/shop/flights/revalidate
TRAVEL_API_ORDER_CREATE_PATH=/v1/trip/orders/create
TRAVEL_API_ORDER_CANCEL_PATH=/v1/trip/orders/cancel
TRAVEL_API_ORDER_CHANGE_PATH=/v1/trip/orders/change
TRAVEL_API_HOTEL_AVAIL_PATH=/v5/get/hotelavail
TRAVEL_API_HOTEL_DETAILS_PATH=/v5/get/hoteldetails
TRAVEL_API_HOTEL_PRICE_CHECK_PATH=/v4.0.0/hotel/pricecheck
TRAVEL_API_HOTEL_BOOKING_PATH=/v2.5.0/passenger/records?mode=create
TRAVEL_API_IATA_NUMBER=
TRAVEL_API_AGENCY_NAME="Karossy Travels"
TRAVEL_API_AGENCY_CITY=Lagos
TRAVEL_API_AGENCY_COUNTRY_CODE=NG
TRAVEL_API_AGENCY_STREET=
TRAVEL_API_AGENCY_POSTAL_CODE=
TRAVEL_API_REQUESTOR_ID=1
TRAVEL_API_COMPANY_CODE=TN
TRAVEL_API_MAX_ITINERARIES=50
